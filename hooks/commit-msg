#!/usr/bin/env bash
# commit-msg gate: enforce Conventional Commits.
set -euo pipefail

MSG_FILE="$1"
# Read first non-comment line (allow multiline bodies; check the header line).
HEADER="$(head -n 1 "$MSG_FILE")"

PATTERN='^(feat|fix|docs|refactor|test|chore|perf|ci|build|style)(\([a-z0-9-]+\))?!?: .{1,72}$'
if ! printf '%s' "$HEADER" | grep -Eq "$PATTERN"; then
  echo "✗ commit message must be Conventional Commits, e.g.:" >&2
  echo "  feat(crawler): add topic tree fetcher" >&2
  echo "  fix(mdconv): handle nested lists" >&2
  echo "  Header must be: type(scope): summary  (summary ≤ 72 chars)" >&2
  exit 1
fi
