# Copy to .env for local runs. Every secret the project can use is documented here.
# Real values live in your environment or a gitignored .env — never in the repo.

# GitHub token used ONLY to create/push the private repository (fine-grained PAT,
# repo-scoped). The crawler itself needs no credentials.
GITHUB_TOKEN=ghp_PLACEHOLDER_NOT_A_REAL_TOKEN

# Optional: point the crawler at a different host (e.g. a mirror) for testing.
M21_BASE_URL=https://www.knowva.ebenefits.va.gov
